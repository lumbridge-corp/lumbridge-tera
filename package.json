    "smoke:sky": "node scripts/sky-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sparkjsdev/spark": "2.4.0",
    "playwright-core": "^1.65.1",
    "satellite.js": "7.2.0",
    "three": "0.187.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "0.187.0",
    "iwer": "^2.8.0",
    "playwright": "^1.65.1",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
