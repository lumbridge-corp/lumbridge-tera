{
  "name": "@lumbridge/tera",
  "version": "0.2.0",
  "description": "Lumbridge Tera: a three.js world engine that agents drive — MCP tools, camera scripts, splats, frame-exact video.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumbridge-corp/lumbridge-tera.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "tera": "bin/tera.ts",
    "tera-mcp": "src/mcp/server.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
