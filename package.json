    "smoke:engine": "node scripts/engine-smoke.mjs",
    "eval:mcp": "node scripts/mcp-eval.ts",
    "smoke:xr": "node scripts/xr-smoke.ts",
    "smoke:viewer": "node scripts/viewer-smoke.ts",
