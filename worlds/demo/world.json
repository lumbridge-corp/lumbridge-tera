{
  "tera": "world/v1",
  "id": "demo",
  "title": "Demo — three shapes at dusk",
  "sky": { "mode": "color", "color": "#1b2230" },
  "environment": { "exposure": 1.5 },
  "entities": [
    { "id": "ground", "kind": "primitive", "shape": "plane", "size": [60, 60], "material": { "color": "#2a3140", "roughness": 1 } },
    { "id": "cube", "kind": "primitive", "shape": "box", "size": [1.6], "transform": { "position": [-2.5, 0.8, 0], "rotation": [0, 25, 0] }, "material": { "color": "#e8d9b0", "roughness": 0.4 } },
    { "id": "ball", "kind": "primitive", "shape": "sphere", "size": [0.9], "transform": { "position": [0, 0.9, 0] }, "material": { "color": "#7fb3ff", "roughness": 0.2, "metalness": 0.3 } },
    { "id": "ring", "kind": "primitive", "shape": "torus", "size": [0.8, 0.22], "transform": { "position": [2.5, 1.0, 0], "rotation": [90, 0, 0] }, "material": { "color": "#ff9f6e", "roughness": 0.35 } },
    { "id": "sun", "kind": "light", "light": "directional", "color": "#ffe2c0", "intensity": 2.4, "castShadow": true, "transform": { "position": [6, 10, 4] } },
    { "id": "sky-fill", "kind": "light", "light": "hemisphere", "color": "#9fb8ff", "intensity": 0.6 }
  ],
  "cameras": { "default": { "position": [7, 4, 9], "target": [0, 0.8, 0], "fov": 45 } }
}
